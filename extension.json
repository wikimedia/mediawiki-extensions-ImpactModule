{
	"name": "ImpactModule",
	"author": [
		"Martin Urbanec"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:ImpactModule",
	"descriptionmsg": "impactmodule-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.47.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\ImpactModule\\": "src/"
	},
	"config": {
		"ImpactModuleThrowOnFailures": {
			"description": "Throw any errors that happen during metric computation (useful for development)",
			"value": false
		},
		"ImpactModuleEnabledMetrics": {
			"description": "List of enabled metrics IDs",
			"value": [
				"example-metric"
			],
			"merge_strategy": "provide_default"
		}
	},
	"SpecialPages": {
		"NewImpact": {
			"class": "MediaWiki\\Extension\\ImpactModule\\Specials\\SpecialImpact",
			"services": [
				"ImpactModuleMetricComputer"
			]
		}
	},
	"ServiceWiringFiles": [
		"src/ServiceWiring.php"
	],
	"ExtensionMessagesFiles": {
		"ImpactModuleAlias": "ImpactModule.alias.php"
	},
	"MessagesDirs": {
		"ImpactModule": [
			"i18n"
		]
	},
	"manifest_version": 2
}
